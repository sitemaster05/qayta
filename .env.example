# Required: Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=
# Required: Google Gemini API key
GEMINI_API_KEY=
# Optional settings below: leave them commented out to use the defaults.
# GEMINI_MODEL=gemini-flash-lite-latest
# URL of the deployed Telegram Mini App
# WEBAPP_URL=
# DB_PATH=data/qayta.db
# Telegram user id of the admin allowed to use /review (0 or unset disables it)
# ADMIN_USER_ID=
